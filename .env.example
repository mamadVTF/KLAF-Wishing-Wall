# Wishing-wall API key (third-party read/write). Required for the "Live" transport.
VITE_API_KEY=

# The wall's project code (a row's code in the projects table).
VITE_PROJECT_CODE=maggi20260910

# Transport used on startup: 'keyboard' (dev panel) or 'websocket' (live wall).
VITE_TRANSPORT=keyboard

# Optional base URL of the wishing-wall API. Leave empty to use the same origin.
VITE_WISH_BASE_URL=
